# =============================================================================
# Shorts Históricos — Variables de entorno
# =============================================================================
# Copia este archivo a .env y completa los valores reales.
# Nunca versiones .env con secretos reales.
#
# ¿Dónde conseguir cada API key?
#   OpenAI:     https://platform.openai.com/api-keys
#   Anthropic:  https://console.anthropic.com/settings/keys
#   ElevenLabs: https://elevenlabs.io/app/settings/api-keys
#   Pexels:     https://www.pexels.com/api/
#   Pixabay:    https://pixabay.com/api/docs/

# --- n8n --------------------------------------------------------------------
N8N_BASE_URL=http://localhost:5679
N8N_ENCRYPTION_KEY=changeme_genera_una_clave_segura_aqui

# --- Proveedor LLM (generación de guiones) ----------------------------------
# Proveedores soportados: openai | anthropic | google
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Alternativa Anthropic (descomenta y comenta las de arriba):
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-3-haiku-20240307

# --- ElevenLabs TTS (narración) ---------------------------------------------
# Voice ID "Rachel" (inglés):   21m00Tcm4TlvDq8ikWAM
# Voice ID español recomendada: Xb7hH8MSUJpSbSDYk0k2
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Pexels (imágenes de fondo) ---------------------------------------------
PEXELS_API_KEY=

# --- Pixabay (imágenes de fondo, alternativo) --------------------------------
PIXABAY_API_KEY=

# --- TTS (narración) --------------------------------------------------------
# Proveedor: edge_tts (default) | elevenlabs
TTS_PROVIDER=edge_tts
# Voz: es-ES-AlvaroNeural, es-ES-ElviraNeural, etc.
TTS_VOICE=es-ES-AlvaroNeural
# Ritmo de habla (WPM) — solo velocidad de voz, sin incluir pausas entre escenas.
# La duración total estimada = spokenDuration + sceneTransitions * estimatedScenePauseMs.
# Observado en Edge TTS español AlvaroNeural: ~110 WPM hablados.
SPOKEN_WORDS_PER_MINUTE=110

# --- Subtítulos -------------------------------------------------------------
# Fuente de timing para subtítulos: auto (default) | edge_tts | whisper | estimated
#   auto       = prefiere Edge TTS WordBoundary, fallback whisper, luego estimated
#   edge_tts   = Edge TTS native word boundaries (más preciso)
#   whisper    = Whisper ASR reconciliation
#   estimated  = distribución uniforme (legacy, menos preciso)
SUBTITLE_TIMING_PROVIDER=auto
# Legacy: solo usado si SUBTITLE_TIMING_PROVIDER no está definido
# whisper requiere: pip install faster-whisper
# Modelo whisper: tiny (default, rápido), base, small, medium, large-v3
SUBTITLE_PROVIDER=estimated
WHISPER_MODEL=tiny

# --- Directorios locales ----------------------------------------------------
OUTPUT_DIR=./data
VIDEOS_DIR=./data/videos

# --- Notificaciones (opcional, futuro) --------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Render worker ----------------------------------------------------------
# Ruta absoluta al proyecto en el host (para el worker que monta rutas en Docker)
PROJECT_ROOT=/home/javi/projects/shorts-historicos

# --- Postgres (n8n) ---------------------------------------------------------
POSTGRES_DB=shorts_history
POSTGRES_USER=shorts_user
POSTGRES_PASSWORD=changeme_genera_una_clave_segura_aqui
