        "options": {
          "encoding": "utf8",
          "keepSource": false,
          "stripBOM": true
        }
      },
      "id": "p4",
      "name": "Parse Metadata",
      "type": "n8n-nodes-base.moveBinaryData",
      "typeVersion": 1.1,
      "position": [
        840,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $input.first().json; const scenes = input.script?.scenes || []; if (!scenes.length) throw new Error('No hay escenas en metadata'); return scenes.map((scene) => ({ json: { jobId: input.jobId, sceneNumber: scene.sceneNumber, visualPrompt: scene.visualPrompt, imagePrompt: scene.imagePrompt || scene.imageSearch || scene.visualPrompt, outputFileName: `/data/assets/${input.jobId}-scene-${String(scene.sceneNumber).padStart(2,'0')}.jpg` } }));"
      },
      "id": "p5",
      "name": "Expand Scenes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "p55",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 2,
      "position": [
        1170,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://image.pollinations.ai/prompt/{{encodeURIComponent($json.imagePrompt || $json.visualPrompt)}}?width=576&height=1024&seed={{$json.sceneNumber}}&nofeed=true",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "p6",
      "name": "Pollinations AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1380,
        300
      ]
    },
    {
      "parameters": {
        "fileName": "={{ $json.outputFileName }}",
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "p9",
      "name": "Write Image File",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [
        2010,
        300
      ]
    }
  ],
