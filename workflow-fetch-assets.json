      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: { filePath: '/data/metadata/hist-2026-06-30-181521.json' } }];"
      },
      "id": "p2",
      "name": "Metadata Path",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ]
    },
    {
