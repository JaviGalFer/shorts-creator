{
  "name": "generate-audio-v1",
  "nodes": [
    {
      "parameters": {},
      "id": "a1",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: { filePath: '/data/metadata/hist-2026-06-30-181521.json' } }];"
      },
      "id": "a2",
      "name": "Metadata Path",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "filePath": "={{ $json.filePath }}",
        "dataPropertyName": "data"
      },
      "id": "a3",
      "name": "Read Metadata",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        620,
        300
      ]
    },
    {
      "parameters": {
        "mode": "binaryToJson",
        "setAllData": true,
        "sourceKey": "data",
        "options": {
          "encoding": "utf8",
          "keepSource": false,
          "stripBOM": true
        }
      },
      "id": "a4",
      "name": "Parse Metadata",
      "type": "n8n-nodes-base.moveBinaryData",
      "typeVersion": 1.1,
      "position": [
        840,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $input.first().json;\nconst scenes = input.script?.scenes || [];\nif (!scenes.length) throw new Error('No hay escenas en metadata');\nreturn scenes.map((scene) => ({ json: { jobId: input.jobId, sceneNumber: scene.sceneNumber, voiceover: scene.voiceover, outputFileName: `/data/audio/${input.jobId}-scene-${String(scene.sceneNumber).padStart(2,'0')}.mp3` } }));"
      },
      "id": "a5",
      "name": "Expand Scenes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "a55",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 2,
      "position": [
        1170,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.elevenlabs.io/v1/text-to-speech/' + $env.ELEVENLABS_VOICE_ID }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "xi-api-key",
              "value": "={{ $env.ELEVENLABS_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept",
              "value": "audio/mpeg"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { text: $json.voiceover, model_id: $env.ELEVENLABS_MODEL_ID || 'eleven_multilingual_v2' } }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "a6",
      "name": "ElevenLabs TTS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1380,
        300
      ]
    },
    {
      "parameters": {
        "fileName": "={{ $json.outputFileName }}",
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "a7",
      "name": "Write Audio File",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [
        1600,
        300
      ]
    }
  ],
  "connections": {
    "Manual Trigger": {
