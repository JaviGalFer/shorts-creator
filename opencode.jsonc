{
  "$schema": "https://opencode.ai/config.json",

  "instructions": [
    "docs/project/agent-context.md"
  ],

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 3000
  },

  "watcher": {
    "ignore": [
      ".git/**",
      "data/**",
      "logs/**",
      "node_modules/**",
      ".venv/**",
      "dist/**",
      "**/__pycache__/**",
      "**/*.pyc",
      "docs/sessions/**",
      ".pytest_cache/**"
    ]
  },

  "mcp": {
    "codebase_memory": {
      "type": "local",
      "command": [
        "/home/javi/.local/bin/codebase-memory-mcp"
      ],
      "cwd": "/home/javi/projects/shorts-creator",
      "enabled": true,
      "timeout": 15000,
      "environment": {
        "CBM_ALLOWED_ROOT": "/home/javi/projects/shorts-creator",
        "CBM_LOG_LEVEL": "warn"
      }
    }
  }
}
